root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,razor,html,css}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion

# EF Core generated migrations are not hand-maintained.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
