@page "/"
@using LiveQuiz.Web.Client.Layout
@using LiveQuiz.Contracts.Sessions
@inject IConfiguration Configuration

<PageTitle>@L["LiveQuiz – play quizzes together"]</PageTitle>

<SiteNav />

<main class="home">
    <section class="hero">
        <div>
            <h1>@L["Quizzes that run on everyone's phone."]</h1>
            <p class="lead">@L["Hosts write the questions. Players join with a PIN, answer against the clock and watch the leaderboard move."]</p>
        </div>
        <form class="join" method="get" action="/play">
            <h2>@L["Got a PIN?"]</h2>
            <label for="home-pin">@L["Game PIN"]</label>
            <input id="home-pin" name="pin" inputmode="numeric" autocomplete="off" maxlength="@SessionLimits.PinLength" placeholder="123456" required />
            <button type="submit">@L["Join the game"]</button>
            <p class="hint">@L["No account needed. You only pick a nickname."]</p>
        </form>
    </section>

    <section id="how" class="how">
        <h2>@L["Start a game in three steps"]</h2>
        <ol>
            <li class="step a">
                <h3>@L["Write a quiz"]</h3>
                <p>@L["Sign in as a host, add questions with up to four answers and a time limit for each."]</p>
            </li>
            <li class="step b">
                <h3>@L["Share the PIN"]</h3>
                <p>@L["Start a game and read out the six-digit PIN. Players appear in the lobby as they join."]</p>
            </li>
            <li class="step c">
                <h3>@L["Play and review"]</h3>
                <p>@L["Reveal each question, show the standings, and open the finished game from your history."]</p>
            </li>
        </ol>
        <div class="actions">
            <a class="primary" href="/host/register">@L["Create a host account"]</a>
            <a class="secondary" href="/host/login">@L["Sign in"]</a>
            @if (Configuration.GetValue<bool>("Demo:Enabled"))
            {
                <a class="secondary" href="/host/login">@L["Try the demo host"]</a>
            }
        </div>
    </section>
</main>
