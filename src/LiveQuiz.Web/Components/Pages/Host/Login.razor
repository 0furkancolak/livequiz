@page "/host/login"
@rendermode HostRenderModes.Server
@using LiveQuiz.Contracts
@using LiveQuiz.Web.Host
@inject BrowserApi Browser
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Sign in</PageTitle>

<HostShell ShowAccount="false">
    <MudPaper Class="pa-6 mx-auto" MaxWidth="420px">
        <MudText Typo="Typo.h5" Class="mb-4">Host sign in</MudText>
        <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="login">
            <MudTextField @bind-Value="_model.Email" Label="Email" InputType="InputType.Email" Required="true" />
            <MudTextField @bind-Value="_model.Password" Label="Password" InputType="InputType.Password" Required="true" />
            @foreach (var message in _errors)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3" role="alert">@message</MudAlert>
            }
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Disabled="_busy" FullWidth="true">Sign in</MudButton>
        </EditForm>
        @if (_demoEnabled)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">Just looking around?</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">A demo host with two ready-to-play quizzes is set up.</MudText>
            <MudButton id="demo-signin" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Disabled="_busy" OnClick="SignInAsDemoAsync">Sign in as the demo host</MudButton>
        }
        <MudText Class="mt-4">No account? <MudLink Href="/host/register">Register</MudLink></MudText>
    </MudPaper>
</HostShell>

@code {
    private readonly Credentials _model = new();
    private List<string> _errors = [];
    private bool _busy;

    private bool _demoEnabled;

    protected override void OnInitialized() => _demoEnabled = Configuration.GetValue<bool>("Demo:Enabled");

    private async Task SignInAsDemoAsync()
    {
        _model.Email = DemoAccount.Email;
        _model.Password = DemoAccount.Password;
        await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _errors = [];
        var result = await Browser.PostJsonAsync("/api/auth/login?useCookies=true", new { email = _model.Email, password = _model.Password });
        if (result.Ok)
        {
            // Full reload: the new circuit must start with the freshly set cookie.
            Navigation.NavigateTo("/host", forceLoad: true);
            return;
        }

        _errors = ["Invalid email or password."];
        _busy = false;
    }

    private sealed class Credentials
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
