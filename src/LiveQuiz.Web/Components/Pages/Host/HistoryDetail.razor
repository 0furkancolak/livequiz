@page "/host/history/{Id:guid}"
@rendermode HostRenderModes.Server
@attribute [Authorize]
@using LiveQuiz.Contracts.Game
@using LiveQuiz.Web.Host
@using LiveQuiz.Web.Services
@inject ApiClient Api

<PageTitle>Game details</PageTitle>

<HostShell>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_detail is null)
    {
        <MudAlert Severity="Severity.Error" role="alert">This game was not found.</MudAlert>
        <MudButton Href="/host/history" Class="mt-4">Back to history</MudButton>
    }
    else
    {
        <MudText Typo="Typo.h4">@_detail.QuizTitle</MudText>
        <MudText Class="mb-4">@_detail.FinishedAtUtc.ToLocalTime().ToString("g")</MudText>

        <MudText Typo="Typo.h6">Standings</MudText>
        <MudSimpleTable id="standings" Class="mb-6">
            <tbody>
                @foreach (var s in _detail.Standings)
                {
                    <tr><td>#@s.Rank</td><td>@s.Nickname</td><td>@s.Points</td></tr>
                }
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.h6">Questions</MudText>
        @foreach (var q in _detail.Questions)
        {
            <MudText Class="mt-2"><b>@(q.Index + 1). @q.Text</b></MudText>
            <MudText Typo="Typo.body2">Answers per option: @string.Join(" · ", q.OptionCounts.Select((n, i) => $"{(char)('A' + i)}{(i == q.CorrectIndex ? "✓" : "")} {n}"))</MudText>
        }
        <MudButton Href="/host/history" Class="mt-4">Back to history</MudButton>
    }
</HostShell>

@code {
    [Parameter] public Guid Id { get; set; }

    private SessionHistoryDetail? _detail;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetHistoryAsync(Id);
        _detail = result.IsSuccess ? result.Value : null;
        _loading = false;
    }
}
