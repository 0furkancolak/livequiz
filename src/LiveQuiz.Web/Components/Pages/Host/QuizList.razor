@page "/host"
@rendermode HostRenderModes.Server
@attribute [Authorize]
@using LiveQuiz.Contracts.Quizzes
@using LiveQuiz.Web.Host
@using LiveQuiz.Web.Services
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@L["My quizzes"]</PageTitle>

<HostShell>
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4" Class="mb-0">@L["My quizzes"]</MudText>
        <MudSpacer />
        <MudButton Href="/host/quizzes/new" Variant="Variant.Filled" Color="Color.Primary">@L["New quiz"]</MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
    }
    else if (_quizzes.Count == 0)
    {
        <MudText id="empty-state">@L["You have no quizzes yet. Create your first one."]</MudText>
    }
    else
    {
        <MudTable Items="_quizzes" Hover="true" Elevation="1">
            <HeaderContent>
                <MudTh>@L["Title"]</MudTh>
                <MudTh>@L["Questions"]</MudTh>
                <MudTh>@L["Updated"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Title"]">@context.Title</MudTd>
                <MudTd DataLabel="@L["Questions"]">@context.QuestionCount</MudTd>
                <MudTd DataLabel="@L["Updated"]">@context.UpdatedAtUtc.ToLocalTime().ToString("g")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" OnClick="() => StartAsync(context)" Disabled="@(context.QuestionCount == 0)" aria-label="@L.Format("Start session for {0}", context.Title)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Href="@($"/host/quizzes/{context.Id}")" aria-label="@L.Format("Edit {0}", context.Title)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="() => DeleteAsync(context)" aria-label="@L.Format("Delete {0}", context.Title)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</HostShell>

@code {
    private List<QuizSummary> _quizzes = [];
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.ListQuizzesAsync();
        if (result.IsUnauthorized)
        {
            Navigation.NavigateTo("/host/login", forceLoad: true);
            return;
        }

        _error = result.IsSuccess ? null : L["Could not load quizzes."];
        _quizzes = result.Value ?? [];
        _loading = false;
    }

    private async Task StartAsync(QuizSummary quiz)
    {
        var result = await Api.StartSessionAsync(quiz.Id);
        if (result.IsSuccess && result.Value is { } session)
            Navigation.NavigateTo($"/host/sessions/{session.SessionId}");
        else
            Snackbar.Add(L["Could not start a session."], Severity.Error);
    }

    private async Task DeleteAsync(QuizSummary quiz)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Delete quiz"], L.Format("Delete \"{0}\" and all its questions?", quiz.Title), yesText: L["Delete"], cancelText: L["Cancel"]);
        if (confirmed != true)
            return;

        var result = await Api.DeleteQuizAsync(quiz.Id);
        if (result.IsSuccess || result.IsNotFound)
            _quizzes.Remove(quiz);
        else
            Snackbar.Add(L["Could not delete the quiz."], Severity.Error);
    }
}
