@page "/host/history"
@rendermode HostRenderModes.Server
@attribute [Authorize]
@using LiveQuiz.Contracts.Game
@using LiveQuiz.Web.Host
@using LiveQuiz.Web.Services
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>History</PageTitle>

<HostShell>
    <MudText Typo="Typo.h4" Class="mb-4">Finished games</MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
    }
    else if (_items.Count == 0)
    {
        <MudText id="empty-history">No finished games yet.</MudText>
    }
    else
    {
        <MudTable Items="_items" Hover="true" Elevation="1">
            <HeaderContent>
                <MudTh>Quiz</MudTh>
                <MudTh>Finished</MudTh>
                <MudTh>Players</MudTh>
                <MudTh>Winner</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Quiz">@context.QuizTitle</MudTd>
                <MudTd DataLabel="Finished">@context.FinishedAtUtc.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="Players">@context.PlayerCount</MudTd>
                <MudTd DataLabel="Winner">@(context.Winner ?? "—")</MudTd>
                <MudTd><MudButton Href="@($"/host/history/{context.Id}")" Size="Size.Small">Details</MudButton></MudTd>
            </RowTemplate>
        </MudTable>
    }
</HostShell>

@code {
    private List<SessionHistoryItem> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.ListHistoryAsync();
        if (result.IsUnauthorized)
        {
            Navigation.NavigateTo("/host/login", forceLoad: true);
            return;
        }

        _error = result.IsSuccess ? null : "Could not load the history.";
        _items = result.Value ?? [];
        _loading = false;
    }
}
