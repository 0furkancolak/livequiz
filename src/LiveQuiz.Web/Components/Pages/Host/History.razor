@page "/host/history"
@rendermode HostRenderModes.Server
@attribute [Authorize]
@using LiveQuiz.Contracts.Game
@using LiveQuiz.Web.Host
@using LiveQuiz.Web.Services
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@L["History"]</PageTitle>

<HostShell>
    <MudText Typo="Typo.h4" Class="mb-4">@L["Finished games"]</MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
    }
    else if (_items.Count == 0)
    {
        <MudText id="empty-history">@L["No finished games yet."]</MudText>
    }
    else
    {
        <MudTable Items="_items" Hover="true" Elevation="1">
            <HeaderContent>
                <MudTh>@L["Quiz"]</MudTh>
                <MudTh>@L["Finished"]</MudTh>
                <MudTh>@L["Players"]</MudTh>
                <MudTh>@L["Winner"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Quiz"]">@context.QuizTitle</MudTd>
                <MudTd DataLabel="@L["Finished"]">@context.FinishedAtUtc.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="@L["Players"]">@context.PlayerCount</MudTd>
                <MudTd DataLabel="@L["Winner"]">@(context.Winner ?? "—")</MudTd>
                <MudTd><MudButton Href="@($"/host/history/{context.Id}")" Size="Size.Small">@L["Details"]</MudButton></MudTd>
            </RowTemplate>
        </MudTable>
    }
</HostShell>

@code {
    private List<SessionHistoryItem> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.ListHistoryAsync();
        if (result.IsUnauthorized)
        {
            Navigation.NavigateTo("/host/login", forceLoad: true);
            return;
        }

        _error = result.IsSuccess ? null : L["Could not load the history."];
        _items = result.Value ?? [];
        _loading = false;
    }
}
