@using LiveQuiz.Web.Client.Layout
@using LiveQuiz.Web.Host
@using LiveQuiz.Web.Services
@inject BrowserApi Browser
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <a class="host-brand" href="/">
            <span class="host-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            LiveQuiz
        </a>
        @if (ShowAccount)
        {
            <MudButton Href="/host" Color="Color.Inherit" Class="ml-4 host-quizzes">@L["Quizzes"]</MudButton>
            <MudButton Href="/host/history" Color="Color.Inherit">@L["History"]</MudButton>
        }
        <MudSpacer />
        <MudButton Href="/play" Color="Color.Inherit" Class="host-join">@L["Join a game"]</MudButton>
        <LanguageSwitch />
        @if (ShowAccount && _email is not null)
        {
            <MudText Class="mr-4 host-email">@_email</MudText>
            <MudButton Color="Color.Inherit" OnClick="SignOutAsync">@L["Sign out"]</MudButton>
        }
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-6">
            @ChildContent
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>False on the sign-in and registration pages.</summary>
    [Parameter] public bool ShowAccount { get; set; } = true;

    private string? _email;

    // Same palette as the public pages (SiteNav, Home, Play) so the whole app reads as one product.
    private static readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4757e6",
            Secondary = "#e0338d",
            Tertiary = "#19b5a5",
            Warning = "#ffc933",
            AppbarBackground = "#1d1a3a",
            AppbarText = "#ffffff",
            Background = "#f6f4ff",
            Surface = "#ffffff",
            TextPrimary = "#1d1a3a",
            DrawerBackground = "#ffffff",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
            H4 = new H4Typography { FontWeight = "800" },
            H5 = new H5Typography { FontWeight = "700" },
            Button = new ButtonTypography { TextTransform = "none", FontWeight = "700" },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px" },
    };

    protected override async Task OnInitializedAsync()
    {
        if (!ShowAccount)
            return;
        var state = await AuthState.GetAuthenticationStateAsync();
        _email = state.User.Identity?.IsAuthenticated == true ? state.User.Identity.Name : null;
    }

    private async Task SignOutAsync()
    {
        await Browser.PostJsonAsync("/api/auth/logout", null);
        Navigation.NavigateTo("/host/login", forceLoad: true);
    }
}
