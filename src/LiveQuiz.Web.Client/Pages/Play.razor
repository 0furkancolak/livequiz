@page "/play"
@rendermode PlayerRenderModes.Wasm
@using System.Diagnostics
@using LiveQuiz.Contracts.Game
@using LiveQuiz.Contracts.Sessions
@using LiveQuiz.Web.Client.Lobby
@implements IAsyncDisposable
@using LiveQuiz.Web.Client.Layout
@inject IPlayerSessionClient Session

<PageTitle>@L["Play"]</PageTitle>

<SiteNav />

<main class="play">
    <h1>LiveQuiz</h1>

    @if (_reconnecting)
    {
        <p id="reconnecting" class="banner" role="status">@L["Connection lost — reconnecting…"]</p>
    }

    @switch (_phase)
    {
        case Phase.Join:
            <form @onsubmit="JoinAsync" novalidate>
                <label for="pin">@L["Game PIN"]</label>
                <input id="pin" @bind="_pin" @bind:event="oninput" inputmode="numeric" autocomplete="off"
                       maxlength="@SessionLimits.PinLength" aria-describedby="pin-error" />
                <p id="pin-error" class="error" role="alert">@_pinError</p>

                <label for="nickname">@L["Nickname"]</label>
                <input id="nickname" @bind="_nickname" @bind:event="oninput" autocomplete="off"
                       maxlength="@SessionLimits.MaxNickname" aria-describedby="nickname-error" />
                <p id="nickname-error" class="error" role="alert">@_nicknameError</p>

                <p class="error" role="alert">@_error</p>
                <button type="submit" disabled="@_busy">@L[_busy ? "Joining…" : "Join"]</button>
            </form>
            break;

        case Phase.Lobby:
            <section aria-live="polite">
                <h2 id="welcome">@L.Format("You're in, {0}", _nicknameShown)</h2>
                <p id="player-count">@L.Format(_count == 1 ? "{0} player in the lobby" : "{0} players in the lobby", _count)</p>
                <p>@L["Waiting for the host to start the game…"]</p>
            </section>
            break;

        case Phase.Question:
            <section>
                <p id="question-progress">@L.Format("Question {0} of {1}", _question!.Index + 1, _question.Total)</p>
                <h2 id="question-text">@_question.Text</h2>
                <p id="countdown" aria-hidden="true">@L.Format("{0} s", RemainingSeconds)</p>
                <div class="options">
                    @for (var i = 0; i < _question.Options.Count; i++)
                    {
                        var index = i;
                        <button type="button" id="@($"option-{index}")" class="option option-@index @(_chosen == index ? "chosen" : "")"
                                disabled="@(_chosen is not null)" @onclick="() => AnswerAsync(index)">
                            <span class="label">@Labels[index]</span> @_question.Options[index]
                        </button>
                    }
                </div>
                <p id="answer-status" role="status">@_answerMessage</p>
            </section>
            break;

        case Phase.Result:
            <section aria-live="polite">
                @if (_result is null)
                {
                    <h2 id="result-pending">@L["Time's up!"]</h2>
                }
                else
                {
                    <h2 id="result-headline" class="@(_result.Correct ? "correct" : "wrong")">
                        @L[_result.Correct ? "Correct!" : _result.Answered ? "Wrong" : "No answer"]
                    </h2>
                    <p id="result-points">@L.Format("+{0} points · {1} total", _result.Points, _result.TotalPoints)</p>
                    <p id="result-rank">@L.Format("Rank {0} of {1}", _result.Rank, _result.PlayerCount)</p>
                }
                @if (_results is not null && _question is not null)
                {
                    <p id="correct-answer">@L["Correct answer:"] <b>@_question.Options[_results.CorrectIndex]</b></p>
                }
                <p>@L["Waiting for the next question…"]</p>
            </section>
            break;

        case Phase.Finished:
            <section>
                <h2 id="finished">@L["Game over"]</h2>
                @if (_result is not null)
                {
                    <p id="final-rank">@L.Format("You finished #{0} with {1} points.", _result.Rank, _result.TotalPoints)</p>
                }
                <ol id="podium">
                    @foreach (var s in _final!.Top.Take(5))
                    {
                        <li>#@s.Rank @s.Nickname — @s.Points</li>
                    }
                </ol>
                <button type="button" @onclick="Reset">@L["Join another game"]</button>
            </section>
            break;

        case Phase.Cancelled:
            <section>
                <h2 id="cancelled">@L["The host closed this game."]</h2>
                <button type="button" @onclick="Reset">@L["Join another game"]</button>
            </section>
            break;
    }

    <p class="runtime">@L["Running in browser:"] <span id="is-wasm">@OperatingSystem.IsBrowser()</span></p>
</main>

@code {
    private enum Phase { Join, Lobby, Question, Result, Finished, Cancelled }

    private static readonly string[] Labels = ["A", "B", "C", "D"];

    [SupplyParameterFromQuery(Name = "pin")] public string? PinFromQuery { get; set; }

    private Phase _phase = Phase.Join;
    private string _nicknameShown = string.Empty;
    private string _pin = string.Empty;
    private string _nickname = string.Empty;
    private string? _pinError, _nicknameError, _error, _answerMessage;
    private int _count;
    private bool _busy, _reconnecting;

    private QuestionForPlayer? _question;
    private QuestionResults? _results;
    private PlayerQuestionResult? _result;
    private FinalResults? _final;
    private int? _chosen;
    private readonly Stopwatch _clock = new();
    private Timer? _ticker;

    // The countdown is cosmetic. The server decides what is on time; this only shows roughly how long is left.
    private int RemainingSeconds => _question is null ? 0 : Math.Max(0, (int)Math.Ceiling((_question.RemainingMs - _clock.ElapsedMilliseconds) / 1000d));

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(PinFromQuery))
            _pin = PinFromQuery.Trim();

        Session.CountChanged += OnCount;
        Session.Cancelled += OnCancelled;
        Session.QuestionStarted += OnQuestionStarted;
        Session.QuestionEnded += OnQuestionEnded;
        Session.ResultReceived += OnResultReceived;
        Session.Finished += OnFinished;
        Session.Reconnecting += OnReconnecting;
        Session.Resumed += OnResumed;
        Session.ConnectionLost += OnConnectionLost;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (await Session.RestoreAsync() is { } restored)
        {
            ApplyState(restored);
            StateHasChanged();
        }
    }

    private async Task JoinAsync()
    {
        _pinError = _nicknameError = _error = null;

        var pin = _pin.Trim();
        if (pin.Length != SessionLimits.PinLength || !pin.All(char.IsAsciiDigit))
            _pinError = L.Format("The PIN has {0} digits.", SessionLimits.PinLength);
        var nicknameCheck = NicknamePolicy.Validate(_nickname);
        if (nicknameCheck != NicknameError.None)
            _nicknameError = L.Translate(NicknamePolicy.Message(nicknameCheck));
        if (_pinError is not null || _nicknameError is not null)
            return;

        _busy = true;
        try
        {
            var attempt = await Session.JoinAsync(pin, NicknamePolicy.Normalize(_nickname));
            if (attempt.Succeeded)
            {
                ApplyState(attempt.State!);
                StateHasChanged();
            }
            else if (attempt.NicknameProblem)
                _nicknameError = L.Translate(attempt.Error);
            else
                _error = L.Translate(attempt.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // One place decides what to show for a state of the game, whether it comes from joining, a page reload
    // or a reconnect, so every path lands on the same screen.
    private void ApplyState(PlayerGameState state)
    {
        _nicknameShown = state.Nickname;
        _count = state.PlayerCount;
        _reconnecting = false;

        switch (state.Phase)
        {
            case SessionPhase.Question when state.Question is not null:
                ShowQuestion(state.Question, state.ChosenIndex);
                break;
            case SessionPhase.Results when state.Question is not null:
                StopTicker();
                _question = state.Question;
                _results = state.Results;
                _result = state.Result;
                _phase = Phase.Result;
                break;
            case SessionPhase.Finished when state.Final is not null:
                StopTicker();
                _final = state.Final;
                _result = state.Result;
                _phase = Phase.Finished;
                break;
            default:
                StopTicker();
                _phase = Phase.Lobby;
                break;
        }
    }

    private void ShowQuestion(QuestionForPlayer question, int? chosen = null)
    {
        _question = question;
        _results = null;
        _result = null;
        _chosen = chosen;
        _answerMessage = chosen is null ? null : L["Answer locked in!"];
        _clock.Restart();
        _ticker?.Dispose();
        _ticker = new Timer(_ => InvokeAsync(StateHasChanged), null, 250, 250);
        _phase = Phase.Question;
    }

    private async Task AnswerAsync(int index)
    {
        if (_question is null || _chosen is not null)
            return;

        _chosen = index;
        var status = await Session.SubmitAnswerAsync(_question.Index, index);
        _answerMessage = status switch
        {
            AnswerStatus.Accepted => L["Answer locked in!"],
            AnswerStatus.TooLate => L["Too late — the question has closed."],
            AnswerStatus.RateLimited => L["Slow down — too many taps."],
            _ => L["Your answer could not be accepted."]
        };
    }

    private void OnCount(int count) => InvokeAsync(() =>
    {
        _count = count;
        StateHasChanged();
    });

    private void OnQuestionStarted(QuestionForPlayer question) => InvokeAsync(() =>
    {
        ShowQuestion(question);
        StateHasChanged();
    });

    private void OnReconnecting() => InvokeAsync(() =>
    {
        _reconnecting = true;
        StateHasChanged();
    });

    private void OnResumed(PlayerGameState state) => InvokeAsync(() =>
    {
        ApplyState(state);
        StateHasChanged();
    });

    private void OnConnectionLost() => InvokeAsync(() =>
    {
        StopTicker();
        _reconnecting = false;
        _phase = Phase.Join;
        _error = L["The connection to the game was lost. Reload this page to rejoin."];
        StateHasChanged();
    });

    private void OnQuestionEnded(QuestionResults results) => InvokeAsync(() =>
    {
        StopTicker();
        _results = results;
        _phase = Phase.Result;
        StateHasChanged();
    });

    private void OnResultReceived(PlayerQuestionResult result) => InvokeAsync(() =>
    {
        _result = result;
        StateHasChanged();
    });

    private void OnFinished(FinalResults final) => InvokeAsync(() =>
    {
        StopTicker();
        _final = final;
        _phase = Phase.Finished;
        StateHasChanged();
    });

    private void OnCancelled() => InvokeAsync(() =>
    {
        StopTicker();
        _phase = Phase.Cancelled;
        StateHasChanged();
    });

    private void StopTicker()
    {
        _ticker?.Dispose();
        _ticker = null;
    }

    private void Reset()
    {
        _phase = Phase.Join;
        _question = null;
        _results = null;
        _result = null;
        _final = null;
        _pin = _nickname = string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        StopTicker();
        Session.CountChanged -= OnCount;
        Session.Cancelled -= OnCancelled;
        Session.QuestionStarted -= OnQuestionStarted;
        Session.QuestionEnded -= OnQuestionEnded;
        Session.ResultReceived -= OnResultReceived;
        Session.Finished -= OnFinished;
        Session.Reconnecting -= OnReconnecting;
        Session.Resumed -= OnResumed;
        Session.ConnectionLost -= OnConnectionLost;
        await Session.DisposeAsync();
    }
}
